# Backend reads this file at repository root. Never commit a populated .env.
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Backend/worker only: privileged secret, bypasses RLS. NEVER use a VITE_ prefix.
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_KEY
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
GITHUB_WEBHOOK_SECRET=REPLACE_WITH_A_LONG_RANDOM_WEBHOOK_SECRET
# Optional future worker; managed Redis over TLS, no local Redis persistence.
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_REDIS_HOST:6379/0
MAX_WEBHOOK_BYTES=1048576

# Docker Compose: Ngrok agent token from your Ngrok account (not the webhook secret).
NGROK_AUTHTOKEN=YOUR_NGROK_AUTHTOKEN
# Compose derives public frontend Supabase settings from SUPABASE_URL/ANON_KEY above.
VITE_DEMO_MODE=false
VITE_API_URL=http://localhost:8000

# GitHub App source access (server only; separate from the OAuth client secret).
GITHUB_APP_ID=
# Base64-encode the downloaded PEM private key onto one line; never commit it.
GITHUB_APP_PRIVATE_KEY_B64=
# Requires repository opt-in as well; see docs/live-scan-pipeline.md.
AI_SCANNING_ENABLED=false
SCANNERS_ENABLED=false
OPENAI_MODEL=gpt-4o
SCAN_MAX_FILES=80
SCAN_MAX_DIFF_CHARS=100000
